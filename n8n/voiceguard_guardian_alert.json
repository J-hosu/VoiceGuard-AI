      "id": "b80924bc-7f6f-49c0-8a91-902cb1d1556e",
      "name": "보호자 설정",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "guardian_chat_id에 알림을 받을 텔레그램 chat id를 넣으세요.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// VoiceGuard 백엔드가 보낸 이벤트를 보호자에게 보낼 문장으로 바꾼다.\nconst item = $input.first().json;\nconst body = item.body ?? {};\nconst d = body.data ?? {};\nconst pct = Math.round((d.risk_score ?? 0) * 100);\nconst link = d.dashboard_url ? `\\n\\n상세 보기: ${d.dashboard_url}` : '';\nlet text = '';\n\nif (body.event === 'incident.high_risk') {\n  text = [\n    '🚨 [VoiceGuard] 보이스피싱 의심 통화가 진행 중입니다',\n    '',\n    `유형: ${d.phishing_type || '확인 중'}`,\n    `위험도: ${pct}%`,\n    `단계: ${d.stage_label || '-'}`,\n    '',\n    d.summary || '',\n    '',\n    '지금 가족에게 다른 방법으로 연락해 통화를 끊도록 도와주세요. 송금이나 앱 설치는 멈추게 해 주세요.',\n  ].join('\\n') + link;\n} else if (body.event === 'followup.answered') {\n  if (d.damage) {\n    text = [\n      '⚠️ [VoiceGuard] 피해가 있었다고 답했습니다',\n      '',\n      `답변: ${d.answer_label}`,\n      `유형: ${d.phishing_type || '-'}`,\n      '',\n      '돈을 보냈다면 지금 바로 112 또는 해당 은행 고객센터에 전화해 지급정지를 요청해야 합니다.',\n      '개인정보를 알려줬거나 앱을 설치했다면 금융감독원 1332, 한국인터넷진흥원 118에 상담하세요.',\n    ].join('\\n') + link;\n  } else {\n    text = [\n      '✅ [VoiceGuard] 통화 후 확인 결과',\n      '',\n      `답변: ${d.answer_label}`,\n      `유형: ${d.phishing_type || '-'} · 위험도 ${pct}%`,\n    ].join('\\n');\n  }\n} else if (body.event === 'call.ended' && d.risk_level === 'high') {\n  text = [\n    '📞 [VoiceGuard] 위험 통화가 끝났습니다',\n    '',\n    `유형: ${d.phishing_type || '-'} · 위험도 ${pct}%`,\n    `도달 단계: ${d.stage_label || '-'}`,\n    '',\n    '가족에게 연락해 송금이나 개인정보 제공이 없었는지 확인해 주세요.',\n  ].join('\\n') + link;\n}\n\nreturn [{\n  json: {\n    event: body.event ?? '',\n    event_id: body.event_id ?? '',\n    log_id: d.log_id ?? null,\n    chat_id: String(item.guardian_chat_id ?? '').trim(),\n    text,\n  },\n}];\n"
      },
      "id": "6d67aa12-87a3-40ba-816a-e5b8fb5558b4",
      "name": "알림 문구 만들기",
